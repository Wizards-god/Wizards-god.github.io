---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, postUrl } from '../../lib/content';
import { fullDate, isoDate } from '../../lib/format';

const posts = await getPosts();
---

<BaseLayout
  title="Writing"
  description="Posts by Parjanya Shankar on building things, probability and quantitative problems."
  ogImage="/og/writing.png"
>
  <div class="page wrap wrap--reading">
    <header class="head">
      <p class="eyebrow" data-enter style="--i: 0">writing</p>
      <h1 class="page-title" data-enter style="--i: 1" tabindex="-1">Writing</h1>
      <p class="lede" data-enter style="--i: 2">
        Longer notes on things I've built and problems I've worked through.
        <a href="/rss.xml" class="rss link link--quiet"><Icon name="rss" size={14} /> RSS</a>
      </p>
    </header>

    {
      posts.length ? (
        <ol class="posts" data-reveal-stagger>
          {posts.map((p) => (
            <li class="post" data-reveal>
              <time class="post__date" datetime={isoDate(p.data.date)}>
                {fullDate(p.data.date)}
              </time>
              <div class="post__body">
                <h2 class="post__title">
                  <a href={postUrl(p)} class="stretched-link">
                    {p.data.title}
                  </a>
                  {p.data.draft && <span class="placeholder-tag">draft</span>}
                </h2>
                <p class="post__excerpt">{p.data.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty">Nothing here yet.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .head {
    margin-bottom: 44px;
  }

  .head .lede {
    margin-top: 14px;
  }

  .rss {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .post {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 640px) {
    .post {
      grid-template-columns: 130px 1fr;
      gap: 20px;
    }
  }

  .post__date {
    padding-top: 4px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 13px;
    white-space: nowrap;
  }

  .post__title {
    font-size: 20px;
    font-weight: 560;
    line-height: 1.3;
  }

  .post__title a {
    color: var(--text);
    transition: color var(--dur-ui) var(--ease-ui);
  }

  @media (hover: hover) and (pointer: fine) {
    .post:hover .post__title a {
      color: var(--accent);
    }
  }

  .post__excerpt {
    margin-top: 6px;
    font-size: 16px;
  }

  .empty {
    color: var(--faint);
    font-family: var(--font-mono);
  }
</style>
