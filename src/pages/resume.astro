---
// Resume: under construction for now. The full HTML resume lives in
// src/pages/resume-print/ and is only built to print public/resume.pdf.
import BaseLayout from '../layouts/BaseLayout.astro';
import CyclingP from '../components/CyclingP.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<BaseLayout title="Resume" description="Parjanya Shankar's resume page is under construction." ogImage="/og/resume.png">
  <div class="page wrap uc">
    <div data-enter style="--i: 0"><CyclingP /></div>
    <h1 class="uc__title" data-enter style="--i: 1" tabindex="-1">Under construction</h1>
    <picture class="uc__emoji" data-enter style="--i: 2">
      <source srcset="/images/construction-still.webp" media="(prefers-reduced-motion: reduce)" />
      <img src="/images/construction.webp" alt="" width="128" height="128" decoding="async" />
    </picture>
    <p class="uc__text" data-enter style="--i: 3">
      My resume is getting a rebuild. It'll be back here soon; until then, feel free to email me.
    </p>
    <p class="uc__actions" data-enter style="--i: 4">
      <a href="/" class="btn btn--primary">
        <Icon name="arrow-left" size={16} /> Back home
      </a>
      <a href={`mailto:${site.email}`} class="btn">
        <Icon name="mail" size={16} /> Email
      </a>
    </p>
    <p class="uc__credit" data-enter style="--i: 5">
      Animated emoji from
      <a href="https://googlefonts.github.io/noto-emoji-animation/" class="link link--quiet" target="_blank" rel="noopener noreferrer">Noto Emoji Animation</a>, CC BY 4.0
    </p>
  </div>
</BaseLayout>

<style>
  .uc {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    min-height: 80vh;
    min-height: 80svh;
    text-align: center;
  }

  .uc__title {
    margin-top: -8px;
    color: var(--text);
    font-size: clamp(44px, 8.5vw, 96px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .uc__emoji img {
    display: block;
    width: 128px;
    height: 128px;
  }

  .uc__text {
    max-width: 440px;
    font-size: 18px;
  }

  .uc__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .uc__credit {
    margin-top: 12px;
    text-wrap: balance;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .uc__credit .link {
    color: var(--faint);
  }
</style>
