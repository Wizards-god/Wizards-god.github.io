---
// The intro overlay. It stays hidden unless the head script decided this visit
// plays the intro (html.intro-active); scripts/intro.ts runs the animation.
// The letters are outlines made at build time by scripts/generate-intro-glyphs.mjs.
import { introGlyphs } from '../data/intro-glyphs';
import { site } from '../data/site';

const { viewBox, letters, period: fullStop, counter } = introGlyphs;

// A rectangle far bigger than any screen: the overlay's solid background.
// scripts/intro.ts later adds the counter to this path to cut the hole. The
// last path, .intro__counter, is an invisible copy of the hole that the script
// uses to measure how far to zoom.
const HUGE = 100000;
const screenCover = `M${-HUGE} ${-HUGE}H${HUGE}V${HUGE}H${-HUGE}Z`;
---

<div
  id="intro"
  class="intro"
  aria-hidden="true"
  data-min-ms={site.intro.minMs}
  data-max-wait-ms={site.intro.maxWaitMs}
>
  <svg
    class="intro__svg"
    viewBox={`${viewBox.x} ${viewBox.y} ${viewBox.w} ${viewBox.h}`}
    style={`--word-w: ${viewBox.w / introGlyphs.upm}`}
    focusable="false"
  >
    <g data-intro-zoom>
      <path class="intro__bg" data-intro-bg fill-rule="evenodd" d={screenCover}></path>
      <!-- Covers the hole in the "a"; fades out as the zoom starts so the site shows through gradually. -->
      <path class="intro__cover" data-intro-cover d={counter.d}></path>
      <g class="intro__ink" data-intro-ink>
        {
          letters.map((letter, index) => (
            <path class:list={['intro__letter', { 'is-on': index === 0 }]} data-intro-letter d={letter.d} />
          ))
        }
        <path class="intro__period" data-intro-period d={fullStop.d} transform={`translate(${fullStop.x[0]} 0)`}></path>
      </g>
      <path class="intro__counter" data-intro-counter d={counter.d}></path>
    </g>
  </svg>
</div>

<noscript><style>.intro{display:none!important}</style></noscript>

<style>
  .intro {
    display: none;
  }

  :global(html.intro-active) {
    overflow: hidden;
  }

  :global(html.intro-active) .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--bg);
    cursor: default;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    /* CSS fail-safe: never cover the site for more than ~6s. */
    animation: intro-failsafe 0.3s calc(6s * var(--slow)) forwards;
  }

  /* Once the counter is cut out, the SVG path alone paints the background. */
  :global(html.intro-active) .intro.has-hole {
    background: transparent;
  }

  .intro__svg {
    width: calc(var(--word-w) * clamp(44px, 12vw, 128px));
    height: auto;
    max-width: none;
    overflow: visible;
  }

  .intro__bg {
    fill: var(--bg);
  }

  .intro__cover {
    fill: var(--bg);
  }

  .intro__letter {
    fill: var(--text);
    opacity: 0;
  }

  .intro__letter.is-on {
    opacity: 1;
  }

  .intro__period {
    fill: var(--accent);
    animation: caret-blink calc(1s * var(--slow)) steps(1) infinite;
  }

  .intro__period:global(.is-typing),
  .intro__period:global(.is-solid) {
    animation: none;
  }

  .intro__counter {
    fill: none;
    stroke: none;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes intro-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
