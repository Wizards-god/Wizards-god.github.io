---
import { site } from '../data/site';

export interface SeoProps {
  title?: string;
  description?: string;
  /** Path of the Open Graph image, e.g. /og/about.png */
  ogImage?: string;
  ogAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og/home.png',
  ogAlt,
  type = 'website',
  published,
  modified,
  jsonLd = [],
  noindex = false,
} = Astro.props as SeoProps;

const fullTitle = title ? `${title} — ${site.name}` : site.name;
// Canonical page URLs end in a slash. Files like /rss.xml are left alone.
const { pathname } = Astro.url;
const isFile = /\.[a-z0-9]+$/i.test(pathname);
const canonicalPath = pathname.endsWith('/') || isFile ? pathname : `${pathname}/`;
const canonical = new URL(canonicalPath, site.domain).href;
const ogUrl = new URL(ogImage, site.domain).href;
const imageAlt = ogAlt ?? `${title ?? site.name}: parjanya.me`;
const introSettings = site.intro;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#1c1c1b" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />

<!--
  Runs before first paint: theme (no flash), ?slow= tuning, and whether this
  load plays the intro, reveals through the shutter, or shows the page as is.
-->
<script is:inline define:vars={{ introSettings }}>
  (function () {
    var root = document.documentElement;
    var classes = root.classList;

    // Storage can throw (private mode, blocked cookies), so every read and write is wrapped.
    function read(storage, key) {
      try { return window[storage].getItem(key); } catch (error) { return null; }
    }
    function write(storage, key, value) {
      try { window[storage].setItem(key, value); } catch (error) {}
    }

    // Theme: the saved choice, otherwise whatever the system prefers.
    var theme = read('localStorage', 'theme');
    if (theme !== 'light' && theme !== 'dark') {
      theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    root.setAttribute('data-theme', theme);
    root.style.colorScheme = theme;
    var themeColours = document.querySelectorAll('meta[name="theme-color"]');
    for (var i = 0; i < themeColours.length; i++) {
      themeColours[i].setAttribute('content', theme === 'light' ? '#f5f4f0' : '#1c1c1b');
    }

    // ?slow=4 makes every animation four times slower, for the rest of the visit.
    var params = new URLSearchParams(location.search);
    var slow = parseFloat(params.get('slow') || '');
    if (slow > 0) write('sessionStorage', 'slow', String(slow));
    else slow = parseFloat(read('sessionStorage', 'slow') || '1') || 1;
    if (slow !== 1) root.style.setProperty('--slow', String(slow));

    var reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    classes.add('js');
    if (!reducedMotion) classes.add('reveal-ready');

    // The intro plays once per visit (?intro=1 forces it, ?intro=0 skips it).
    // A later full page load in the same visit opens with the shutter instead.
    var introParam = params.get('intro');
    var introSeen = read('sessionStorage', 'intro-seen') === '1';
    var playIntro = introSettings.enabled && introParam !== '0' && (introParam === '1' || !introSettings.oncePerSession || !introSeen);
    if (playIntro) {
      classes.add('intro-active', 'chrome-wait');
      if (reducedMotion) classes.add('intro-reduced');
      write('sessionStorage', 'intro-seen', '1');
    } else if (introSeen && introParam !== '0' && !reducedMotion) {
      classes.add('page-entering', 'chrome-wait', 'content-wait');
    } else {
      classes.add('chrome-in', 'content-in');
      write('sessionStorage', 'intro-seen', '1');
    }

    // Fail-safe: if the main script never starts, show everything anyway.
    setTimeout(function () {
      if (window.__siteReady) return;
      classes.remove('reveal-ready', 'content-wait', 'chrome-wait', 'page-entering', 'intro-active');
      classes.add('content-in', 'chrome-in');
    }, 4000 * slow);
  })();
</script>

<link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={`${site.name}: Writing`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_GB" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
<meta name="author" content={site.name} />
{jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}

{
  site.analytics.goatcounter && (
    <>
      <script
        is:inline
        async
        data-goatcounter={`https://${site.analytics.goatcounter}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"
      />
      <script is:inline>
        document.addEventListener('astro:after-swap', function () {
          if (window.goatcounter && window.goatcounter.count) window.goatcounter.count({ path: location.pathname });
        });
      </script>
    </>
  )
}
